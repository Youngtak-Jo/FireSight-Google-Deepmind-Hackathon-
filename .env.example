# GEMINI_API_KEY: Required for server-side Gemini Live and Argon API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for Maps JavaScript API, Routes API, Places API, Geocoding API, and Weather API.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: Public HTTPS URL where this applet is hosted on Cloud Run.
APP_URL="MY_APP_URL"

# --- 실시간 도로 상황·CCTV (선택) — 없으면 화면에 '추정값'으로 표시 ---
# 카카오 디벨로퍼스 REST API 키: 실시간 교통을 반영한 출동 소요시간 (카카오모빌리티 자동차 길찾기)
KAKAO_REST_API_KEY="MY_KAKAO_REST_API_KEY"

# 서울 열린데이터광장 인증키: 서울 실시간 도시데이터 (도로소통·사고통제·날씨·혼잡도)
SEOUL_OPEN_API_KEY="MY_SEOUL_OPEN_API_KEY"

# ITS 국가교통정보센터 오픈데이터 인증키: 도로 CCTV 실시간 영상
ITS_API_KEY="MY_ITS_API_KEY"
