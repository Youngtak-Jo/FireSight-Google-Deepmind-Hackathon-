# GEMINI_API_KEY: Required for server-side Gemini Live and Argon API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for Maps JavaScript API, Routes API, Places API, Geocoding API, and Weather API.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: Public HTTPS URL where this applet is hosted on Cloud Run.
APP_URL="MY_APP_URL"
